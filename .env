# GROW WING — Environment Variables
# DO NOT commit this file to public version control

ADMIN_USERNAME=anson
ADMIN_PASSWORD=no1promotion
JWT_SECRET=GrowWing_JWT_Secret_2026_SecureKey
PORT=3000

# ── Gmail Email Settings ─────────────────────────────────────────
# Send lead notifications to this address:
ADMIN_EMAIL=growwingpromotions@gmail.com

# Gmail account used to SEND the emails (can be the same address):
GMAIL_USER=growwingpromotions@gmail.com

# IMPORTANT: Use an App Password (NOT your regular Gmail password)
# How to create one:
#  1. Go to https://myaccount.google.com/security
#  2. Enable 2-Step Verification
#  3. Go to Security > App Passwords
#  4. Select "Mail" and "Windows Computer" → Generate
#  5. Paste the 16-character password below (no spaces):
GMAIL_APP_PASSWORD=your_16_char_app_password_here
